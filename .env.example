# Conexión a la base de datos Postgres (Neon)
DATABASE_URL=

# Cloudflare R2: guarda imágenes de modelo, logotipos e imágenes de diseño congeladas
# (ver specs/005-migrar-subida-archivos-r2/guia-configuracion-cloudflare.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Dominio público desde el que se sirven los archivos (r2.dev o dominio propio conectado al bucket)
R2_PUBLIC_BASE_URL=

# Resend: envío de correos de notificación
RESEND_API_KEY=
# A quién le llega el aviso de solicitud nueva
ADMIN_NOTIFY_EMAIL=

# Firma la cookie de sesión del panel (cualquier cadena larga y aleatoria)
SESSION_SECRET=

# Protege las tareas programadas (/api/cron/*)
CRON_SECRET=

# ⚠ Pendientes de confirmar con la fábrica (ver checklists/requirements.md)
MAX_LOGO_MB=5
LOGO_FORMATS=png,svg,jpg
DEFAULT_ZONE_TEXT_CHARS=20
MAX_DECORATED_ZONES=3
